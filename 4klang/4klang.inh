// some useful song defines for 4klang
#define SAMPLE_RATE 44100
#define BPM 174.000000
#define MAX_INSTRUMENTS 10
#define MAX_PATTERNS 123
#define PATTERN_SIZE_SHIFT 4
#define PATTERN_SIZE (1 << PATTERN_SIZE_SHIFT)
#define MAX_TICKS (MAX_PATTERNS*PATTERN_SIZE)
#define SAMPLES_PER_TICK 3801
#define MAX_SAMPLES (SAMPLES_PER_TICK*MAX_TICKS)
#define POLYPHONY 1
#define INTEGER_16BIT
#define SAMPLE_TYPE short
#define SINGLE_TICK_RENDERING

#define MACOSX_OBJECT

// declaration of the external synth render function, you'll always need that
extern void* _4klang_render(void*);

#ifdef SINGLE_TICK_RENDERING
extern int _4klang_current_tick;
#endif

#define SAMPLES_PER_BEAT 15204
